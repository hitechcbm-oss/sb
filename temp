#include<wire.h>
#define sda 12
#define scl 13
#define add 0x10
void setup(){
    serial.begin(115000);
    wire.begin(sda,scl);
}
void loop(){
wire.beginTransmission(add);
wire.write(0x00);
wire.endtransmission();
wire.requestForm(add,2);
if(wire.available()==2){
    int msb=wire.read();
    int lsb=wire.read();
    int value=(msb<<8)|lsb;
    value=value>>7;
    if(value&0x100){
        value-=512;
    }
    float temp=value*0.5;
    serial.print("temp");

}
delay(1000);

}

